# Kernel config options required by Halium / Ubuntu Touch.
# This file is merged with fleur_defconfig via deviceinfo:
#   deviceinfo_kernel_defconfig="fleur_defconfig halium.config"
# Base list from:
#   https://docs.ubports.com/en/latest/porting/build_and_boot/standalone_kernel_build.html
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y

# Not in the minimal doc list, but Halium's Android userspace needs
# /dev/binder, /dev/hwbinder and /dev/vndbinder to start at all.
CONFIG_ANDROID_BINDER_IPC=y

# Android shared memory driver (used by several Android HALs).
CONFIG_ASHMEM=y

# On-screen kernel console: without this, console=tty0 has no visible
# output and boot failures are undiagnosable (black screen, no telnet).
CONFIG_FRAMEBUFFER_CONSOLE=y
